# Names only. Put real values in .env.local. Do not commit secrets.
# Staff portal usernames and passwords are not used.

# Neon Postgres, from the Vercel Marketplace integration.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Shopify Dev Dashboard app. Client-credentials grant, not a copied Admin token.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Shopify custom app: read_orders plus read_all_orders for full B2B history.

# HubSpot private app token. Industry Type is the industry_type company property.
HUBSPOT_ACCESS_TOKEN=

# ZoomInfo GTM API (Developer Portal app + integration user).
ZOOMINFO_CLIENT_ID=
ZOOMINFO_CLIENT_SECRET=
# Optional: comma-separated searches (see docs/zoominfo-source.md).
ZOOMINFO_INDUSTRY_KEYWORDS=
ZOOMINFO_COMPANY_NAMES=
ZOOMINFO_STATE=

# ShipStation API key and secret.
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=

# Google service account JSON, raw or base64. Share each sheet with that account.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_SKU_ID=
GOOGLE_SHEET_LTL_ID=
GOOGLE_SHEET_LOCATOR_ID=
GOOGLE_SHEET_LOCATOR_GID=
GOOGLE_SHEET_LOCATOR_TAB=
GOOGLE_SHEET_PROMO_ID=
# Tab gid from the sheet URL (#gid=...) or set GOOGLE_SHEET_PROMO_TAB to the tab name.
GOOGLE_SHEET_PROMO_GID=
GOOGLE_SHEET_PROMO_TAB=
# KEHE tab — share each spreadsheet with the service account (Viewer).
GOOGLE_SHEET_KEHE_SALES_ID=
GOOGLE_SHEET_KEHE_SALES_GID=
GOOGLE_SHEET_KEHE_SALES_TAB=
GOOGLE_SHEET_KEHE_STOCK_ID=
GOOGLE_SHEET_KEHE_STOCK_GID=
GOOGLE_SHEET_KEHE_STOCK_TAB=

# DSD — ALL SALES REPORTS on Drive (optional; defaults to Leilo folder id when unset).
GOOGLE_DRIVE_DSD_REPORTS_FOLDER_ID=
# SPINS — Drive sync (service account). Defaults: SPINS Data + SPINS ARK DATA folders.
GOOGLE_DRIVE_SPINS_FOLDER_ID=
GOOGLE_DRIVE_SPINS_ARK_FOLDER_ID=
# Or set several ids at once (comma-separated) and skip the two vars above:
GOOGLE_DRIVE_SPINS_FOLDER_IDS=
# Optional JSON: [{"fileId":"…","report":"item-rank","weeks":12,"name":"Label"}] overrides auto-matching.
GOOGLE_DRIVE_SPINS_MANIFEST=

# SPINS Data Access API ($8k/yr). Leave blank when using Drive or file upload.
SPINS_API_KEY=
SPINS_API_URL=

# Brand kit tab — Google Drive folder/file ids (optional; defaults match Leilo shared drives).
GOOGLE_DRIVE_BRAND_POS_ID=
GOOGLE_DRIVE_BRAND_ASSETS_ID=
GOOGLE_DRIVE_BRAND_KIT_ZIP_ID=
# Future: GOOGLE_DRIVE_SPINS_FOLDER_ID= when SPINS Drive sync is wired.
